{
  "$defs": {
    "Condition": {
      "enum": [
        "baseline",
        "memory",
        "memory_verifier",
        "scripted"
      ],
      "title": "Condition",
      "type": "string"
    },
    "TerminationReason": {
      "enum": [
        "tests_passed",
        "max_iterations",
        "max_tool_calls",
        "max_tokens",
        "max_cost",
        "environment_failure",
        "provider_abort",
        "invalid_action",
        "evaluator_failed"
      ],
      "title": "TerminationReason",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "VerificationResult": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "title": "Command",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "output": {
          "title": "Output",
          "type": "string"
        },
        "runtime_seconds": {
          "minimum": 0,
          "title": "Runtime Seconds",
          "type": "number"
        },
        "tests_collected": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests Collected"
        },
        "tests_passed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests Passed"
        },
        "tests_failed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tests Failed"
        },
        "environment_error": {
          "default": false,
          "title": "Environment Error",
          "type": "boolean"
        }
      },
      "required": [
        "command",
        "exit_code",
        "passed",
        "output",
        "runtime_seconds"
      ],
      "title": "VerificationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "condition": {
      "$ref": "#/$defs/Condition"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "termination_reason": {
      "$ref": "#/$defs/TerminationReason"
    },
    "resolved": {
      "title": "Resolved",
      "type": "boolean"
    },
    "visible_verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluator_verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "patch_valid": {
      "default": true,
      "title": "Patch Valid",
      "type": "boolean"
    },
    "regression_detected": {
      "default": false,
      "title": "Regression Detected",
      "type": "boolean"
    },
    "iterations": {
      "minimum": 0,
      "title": "Iterations",
      "type": "integer"
    },
    "tool_calls": {
      "minimum": 0,
      "title": "Tool Calls",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "runtime_seconds": {
      "minimum": 0,
      "title": "Runtime Seconds",
      "type": "number"
    },
    "trace_path": {
      "title": "Trace Path",
      "type": "string"
    },
    "workspace_path": {
      "title": "Workspace Path",
      "type": "string"
    },
    "provider": {
      "default": "unknown",
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "retrieved_memory_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Retrieved Memory Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "condition",
    "started_at",
    "finished_at",
    "termination_reason",
    "resolved",
    "iterations",
    "tool_calls",
    "runtime_seconds",
    "trace_path",
    "workspace_path"
  ],
  "title": "RunSummary",
  "type": "object"
}
