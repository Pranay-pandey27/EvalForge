{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "default": 8,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 40,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_cost_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Usd"
        },
        "command_timeout_seconds": {
          "default": 60.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Command Timeout Seconds",
          "type": "number"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Condition": {
      "enum": [
        "baseline",
        "memory",
        "memory_verifier",
        "scripted"
      ],
      "title": "Condition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Reproducible experiment configuration loaded from JSON.",
  "properties": {
    "suite_dir": {
      "format": "path",
      "title": "Suite Dir",
      "type": "string"
    },
    "output_dir": {
      "default": "experiments/runs",
      "format": "path",
      "title": "Output Dir",
      "type": "string"
    },
    "conditions": {
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "minItems": 1,
      "title": "Conditions",
      "type": "array"
    },
    "provider": {
      "default": "litellm",
      "enum": [
        "litellm",
        "scripted"
      ],
      "title": "Provider",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "repeats": {
      "default": 1,
      "maximum": 100,
      "minimum": 1,
      "title": "Repeats",
      "type": "integer"
    },
    "seed": {
      "default": 17,
      "title": "Seed",
      "type": "integer"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "memory_db": {
      "anyOf": [
        {
          "format": "path",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Db"
    },
    "persist_memory": {
      "default": false,
      "title": "Persist Memory",
      "type": "boolean"
    },
    "runner": {
      "default": "local",
      "enum": [
        "local",
        "docker"
      ],
      "title": "Runner",
      "type": "string"
    },
    "docker_image": {
      "default": "evalforge-bench:latest",
      "title": "Docker Image",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "suite_dir"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}
