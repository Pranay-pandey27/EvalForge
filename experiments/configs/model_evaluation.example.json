{
  "suite_dir": "benchmarks/evaluation",
  "output_dir": "experiments/runs/model-evaluation",
  "conditions": ["baseline", "memory", "memory_verifier"],
  "provider": "litellm",
  "model": "MODEL_ID_HERE",
  "repeats": 3,
  "seed": 17,
  "budget": {
    "max_iterations": 8,
    "max_tool_calls": 40,
    "max_tokens": 50000,
    "max_cost_usd": 5.0,
    "command_timeout_seconds": 60
  },
  "memory_db": "experiments/memory/frozen.sqlite",
  "persist_memory": false,
  "runner": "docker",
  "docker_image": "evalforge-bench:latest",
  "schema_version": "1.0"
}
